  "publications": [
    {
      "title": "Visualizing Machine Learning with a Fluid Simulation",
      "journal": "SLU ForALL Math Magazine",
      "date": "March 2025",
      "description": "This paper shows how handwritten numbers can be recognized by simulating how water would flow over their shapes and using those flow patterns to tell digits apart. It applies vector calculus and a vector database to make machine-learning concepts more visual and intuitive, rather than relying on complex AI models.",
